# Optional overrides for `docker compose up` (copy to .env, git-ignored).
# Everything has a LOCAL-ONLY default in docker-compose.yml; set real random
# values (openssl rand -hex 32) if the stack is reachable by anyone else.

# Host ports (bound to 127.0.0.1 only)
FRONT_PORT=3000
GATEWAY_PORT=8080
POSTGRES_PORT=5440

# Demo users and data (1 = load, 0 = empty databases)
WITH_DEMO_DATA=1

# Shared service secrets
INTERNAL_SECRET=
CONTROL_ACCESOS_GATEWAY_SECRET=
NOTIFICACIONES_GATEWAY_SECRET=
# >= 32 bytes; shared by the gateway and auth
AUTH_TENANT_HMAC_SECRET=
# Signs dev-login tokens (control-de-accesos /dev/token)
DEV_JWT_SECRET=

# Database passwords. Only applied when the postgres volume is created:
# after changing them run `docker compose down -v` (deletes local data).
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
CONTROL_ACCESOS_DB_PASSWORD=
NOTIFICACIONES_DB_PASSWORD=

# Gateway rate limits (req/min)
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=300
