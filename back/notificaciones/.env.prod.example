# Copiar a .env.prod (no commitear) para docker-compose.prod.yml
# notificaciones:latest si se usa `make ship`; si no, la imagen del registro
MS_IMAGE=notificaciones:latest
HOST_PORT=8083

# RDS compartida: rol y schema `notificaciones` (creados con db/bootstrap.sql).
# search_path=notificaciones es obligatorio: sin él las tablas irían a `public`.
# La clave va URL-encoded si tiene caracteres especiales (@ : / ? # &).
DATABASE_URL=postgres://notificaciones:<clave>@<endpoint-rds>:5432/<base>?sslmode=require&search_path=notificaciones
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2

# Obligatorio en producción; el mismo valor que tendrá el gateway como
# NOTIFICACIONES_SECRET. Generar: openssl rand -hex 32
GATEWAY_SECRET=

# Obligatorio en producción; el mismo valor en todos los ms que crean
# notificaciones (control-de-accesos lo usa como INTERNAL_SECRET).
# Generar: openssl rand -hex 32
INTERNAL_SECRET=

# Push (opcional). Vacío = solo bandeja. El archivo va en ./secrets/ con permisos 644.
FIREBASE_CREDENTIALS_FILE=
# FIREBASE_CREDENTIALS_FILE=/secrets/firebase.json
FIREBASE_PROJECT_ID=
# URL https del front: el clic en un push del navegador abre WEB_APP_URL + deep_link
WEB_APP_URL=
