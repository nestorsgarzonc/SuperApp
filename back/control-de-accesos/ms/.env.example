ENV=development
PORT=8080
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
DB_HOST=localhost
DB_PORT=5433
DB_USER=control_de_accesos
DB_PASSWORD=control_de_accesos
DB_NAME=control_de_accesos
DB_SSLMODE=disable

# Optional, AWS RDS readiness (unused locally — see README "Producción / AWS RDS"):
# DB_SSLROOTCERT=/path/to/global-bundle.pem   # for DB_SSLMODE=verify-full
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=5

# Optional: base URL of the notificaciones microservice. Leave empty (default)
# until that service exists — access events are then simply not sent anywhere.
NOTIFICATIONS_URL=
