ENV=development
PORT=8080
# Generate: openssl rand -hex 32
JWT_SECRET=
# Behind the api-gateway (docs/api-gateway.md): secret the gateway sends as
# X-Gateway-Secret with the identity it validated. With it set, JWT_SECRET is optional.
# Generate: openssl rand -hex 32
GATEWAY_SECRET=
# Tokens RS256 emitidos por el servicio auth (producción sin gateway): llaves públicas (JWKS),
# issuer y audience deben coincidir con AUTH_JWT_ISSUER / AUTH_JWT_AUDIENCE de auth.
# El conjunto y el rol salen de X-Complex-ID + las membresías de este servicio.
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=superapp-api

# Secret for /internal/* (X-Internal-Secret). Empty = /internal is not mounted.
INTERNAL_SECRET=
DB_HOST=localhost
DB_PORT=5433
DB_USER=control_de_accesos
DB_PASSWORD=
DB_NAME=control_de_accesos
DB_SSLMODE=disable

# Optional:
# DB_SSLROOTCERT=/path/to/ca-bundle.pem   # for DB_SSLMODE=verify-full
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=5

# Optional: Redis where notification requests are published for the notificaciones
# service (stream notifications.requested). Empty = disabled.
REDIS_URL=
# NOTIFICATIONS_STREAM=notifications.requested
