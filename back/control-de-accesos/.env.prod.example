# Copiar a .env.prod (no commitear) para docker-compose.prod.yml
MS_IMAGE=
HOST_PORT=8080

# Tokens de auth (RS256): URL del JWKS, issuer y audience iguales a los de auth
AUTH_JWKS_URL=http://<host-de-auth>:8081/.well-known/jwks.json
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=superapp-api
# Opcionales. Generar: openssl rand -hex 32
JWT_SECRET=
GATEWAY_SECRET=
# Vacío = /internal/* no se monta
INTERNAL_SECRET=

# RDS
DB_HOST=
DB_PORT=5432
DB_USER=control_de_accesos
DB_PASSWORD=
DB_NAME=control_de_accesos
DB_SSLMODE=require
# DB_SSLROOTCERT=/ruta/al/rds-ca-bundle.pem   # solo con DB_SSLMODE=verify-full

# Redis compartido con notificaciones (p. ej. ElastiCache). Vacío = desactivado.
REDIS_URL=
