AUTH_ADDR=:8081
AUTH_DATABASE_URL=postgres://auth_user:change-me@localhost:5434/auth_db?sslmode=disable
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=superapp-api
JWT_PRIVATE_KEY_FILE=./keys/jwt-private.pem
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Required to accept tenant context. Set the matching secret at the trusted API Gateway.
GATEWAY_TENANT_HMAC_SECRET=replace-with-at-least-32-random-bytes
