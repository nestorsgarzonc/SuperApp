VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK_API=true
VITE_LOGO_URL=/src/assets/brand/logo.svg
# Dev API fallback for the existing control-accesos module.
ACCESS_URL=http://localhost:8081
# Use this once the API Gateway is available.
# GATEWAY_URL=http://localhost:8080
# Mientras no exista el gateway, las rutas de notificaciones van directo a su ms
# (cd back/notificaciones && make run). Ignorado si GATEWAY_URL está definido.
NOTIFICACIONES_URL=http://localhost:8083
# Push web (Firebase Cloud Messaging). Vacío = sin push, solo bandeja.
# Firebase console → Project settings → General → Your apps (Web) y
# Cloud Messaging → Web Push certificates (VAPID). Se fijan al hacer el build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
